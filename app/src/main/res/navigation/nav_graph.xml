<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.drive.axleweightcalc.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_Home_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.drive.axleweightcalc.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_Home"
            app:destination="@id/navigation_home" />
    </fragment>

    <!-- Placeholders for other bottom nav items to avoid confusion -->
    <fragment
        android:id="@+id/navigation_expenses"
        android:name="com.drive.axleweightcalc.FirstFragment"
        android:label="Expenses"
        tools:layout="@layout/fragment_first" />
    <fragment
        android:id="@+id/navigation_ifta"
        android:name="com.drive.axleweightcalc.FirstFragment"
        android:label="IFTA"
        tools:layout="@layout/fragment_first" />
    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.drive.axleweightcalc.FirstFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_first" />
</navigation>